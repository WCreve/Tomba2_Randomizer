<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Tomba2_Randomizer"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" CanResize="False"
        Width="1340" Height="760"
        x:Class="Tomba2_Randomizer.MainWindow"
        Title="Tomba2 Randomizer v0.2.0.alpha1">
    <Grid>
        <TabControl Name="TabControl" SelectionChanged="SelectingItemsControl_OnSelectionChanged">
            <TabItem Name="TabMain" Header="Main">
                <Canvas>
                    <Label Name="LblHooked" Content="Connected" HorizontalAlignment="Left" Margin="29,21,0,0" VerticalAlignment="Top"/>
                    <Label Name="LblRandomizer" Content="No randomizer loaded." Margin="29,51,0,0"></Label>
                    <Canvas Name="CnvRandomizerSetup">
                        <Button Name="BtnNewRandom" Content="Start Randomizer" FontSize="24" Canvas.Left="28" Canvas.Top="99" Height="59" Width="230" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnNewRandom_OnClick"/>
                        <CheckBox Name="ChkDebug" Content="Generate item list text file" Canvas.Left="278" Canvas.Top="115" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <CheckBox Name="ChkUseSeed" Content="Use seed" Margin="29,176,0,0" IsCheckedChanged="ChkUseSeed_IsCheckedChanged"></CheckBox>
                        <TextBox IsEnabled="False" Name="TxtSeed" Margin="150, 175, 0, 0" Width="150" HorizontalContentAlignment="Right"></TextBox>
                        <Label Name="LblRecentSeeds" IsVisible="False" Content="Recent seeds" Margin="29,225,0,0"></Label>
                        <ComboBox Name="CmbRecentSeeds" IsVisible="False" SelectedIndex="0" Canvas.Left="150" Canvas.Top="220" Width="280" PlaceholderText="Select a seed from the dropdown" HorizontalContentAlignment="Right" SelectionChanged="CmbRecentSeeds_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:RandomizerSeed">
                                    <TextBlock Text="{Binding SeedString}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    
                        <!--<Button Name="BtnJsonDeserializer" Content="dump info" FontSize="24" Canvas.Left="28" Canvas.Top="276" Height="58" Width="290" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnJsonDeserializer_Click"/>-->

                        <CheckBox Name="ChkSettingMusic" Content="Shuffle music" Margin="450, 220, 0, 0"></CheckBox>
                    </Canvas>
                    <Canvas Name="CnvRandomizerActive" IsVisible="False">
                        <Button Name="BtnStopRandomizer" Content="Stop randomizer" FontSize="24" Canvas.Left="28" Canvas.Top="99" Height="59" Width="230" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnStopRandomizer_Click"></Button>
                        <TextBlock Canvas.Left="235" Canvas.Top="195" Text="{Binding #SldItemsPerRow.Value}" />
                        <Label Canvas.Left="30" Canvas.Top="210" Content="Items per row"></Label>
                        <Slider Name="SldItemsPerRow" Canvas.Left="150" Canvas.Top="200" Width="200" Minimum="7" Maximum="26" TickFrequency="1" Value="16" IsSnapToTickEnabled="True" ValueChanged="SldItemsPerRow_ValueChanged"></Slider>
                        <Button Name="BtnToggleBackground" Content="Toggle Background" Canvas.Left="30" Canvas.Top="260" Click="BtnToggleBackground_Click"></Button>
                        <CheckBox Name="ChkItemTrackerType" Content="Show randomized items" Canvas.Left="30" Canvas.Top="310" IsChecked="True" IsCheckedChanged="ChkItemTrackerType_IsCheckedChanged"></CheckBox>
                        <Canvas Name="CnvItemTracker" Canvas.Left="400" Canvas.Top="20" Width="950" Height="800"></Canvas>
                    </Canvas>
                </Canvas>
            </TabItem>
            <TabItem IsEnabled="false" Header="Inventory" Name="TabInventory" Height="20" VerticalAlignment="Top">
                <StackPanel Background="#191919" Orientation="Horizontal">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Width="920">
                        <Canvas Name="CnvItems" VerticalAlignment="Top" ></Canvas>
                    </ScrollViewer>
                    <Canvas>
                        <TextBox Name="TxtSelectedItemAmount" Width="34" Height="18" Canvas.Left="161" Canvas.Top="100" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Right"></TextBox>
                        <Label Content="Amount" Canvas.Left="87" Canvas.Top="105" Foreground="White"/>
                        <Button Name="BtnSelectedItemApply" Classes="apply" Content="Apply" Height="31" Canvas.Left="69" Canvas.Top="151" Width="126" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnSelectedItemApply_OnClick"/>
                        <ComboBox Name="CmbItems" Canvas.Left="50" Canvas.Top="37" Width="164" HorizontalAlignment="Center" VerticalAlignment="Top" SelectionChanged="CmbItems_OnSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ItemDto">
                                    <TextBlock Text="{Binding GUIName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!--<Button Name="BtnGiveAll" Classes="apply" Content="Give All Items" Height="31" Canvas.Left="69" Canvas.Top="201" Width="126" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnGiveAll_Click"/>-->
                    </Canvas>
                </StackPanel>
            </TabItem>
            <TabItem IsEnabled="false" Header="Events" Name="TabEvents" Height="20" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Canvas Name="CnvEvents" Background="#191919" VerticalAlignment="Top"></Canvas>
                </ScrollViewer>
            </TabItem>
            <TabItem IsEnabled="false" Header="Teleport" Name="TabTeleport" Height="20" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Canvas>
                    <Button Name="BtnTeleport" Content="Teleport" FontSize="64" Height="123" Canvas.Left="340" Canvas.Top="328" Width="314" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnTeleport_OnClick"/>
                    <ComboBox Name="CmbAreas" Canvas.Left="102" Canvas.Top="147" Width="223" Height="30" SelectionChanged="CmbAreas_OnSelectionChanged" PlaceholderText="Select an Area">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:TeleportArea">
                                <TextBlock Text="{Binding Name}" FontSize="18"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Name="CmbSections" Canvas.Left="458" Canvas.Top="147" Width="450" Height="30" HorizontalAlignment="Left" PlaceholderText="Select a Destination">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:Section">
                                <TextBlock Text="{Binding Destination}" FontSize="18"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Canvas>
            </TabItem>
            <TabItem IsEnabled="false" Header="Game Progress" Name="TabProgress" Height="20" VerticalAlignment="Top">
                <Canvas>
                    <Grid Name="GrdProgress" VerticalAlignment="Top" HorizontalAlignment="Left" Width="1120" Height="690"
                          ColumnDefinitions="140,140,140,140,140,140,140,140"
                          RowDefinitions="32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32">
                    </Grid>
                    <Button Name="BtnProgressRefresh" Content="Refresh" FontSize="24" Canvas.Left="1160" Canvas.Top="562" Height="50" Width="145" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnProgressRefresh_OnClick"/>
                    <Button Name="BtnProgressSetValues" Content="Set Values" FontSize="24" Canvas.Left="1160" Canvas.Top="634" Height="50" Width="145" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnProgressSetValues_OnClick"/>
                </Canvas>
            </TabItem>
        </TabControl>
    </Grid>
    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="LightGray"/>
        </Style>
        <Style Selector="Button.item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D2D"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#73D66B"/>
        </Style>
        <Style Selector="Button.blue:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#5ABDDE"/>
        </Style>
        <Style Selector="Button.pink:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#DE6394"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Styles>
</Window>
